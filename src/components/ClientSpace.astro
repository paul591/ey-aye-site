---
// One client's file space: folders, files, upload box. Used by /clients/ (the client's own view)
// and /clients/admin/?client=… (Paul's view of any client, with delete buttons).
import {
  ALLOWED_TYPES,
  fileSize,
  longDate,
  MAX_UPLOAD_BYTES,
  spaceUrl,
  type Client,
  type ClientFile,
  type Folder,
} from '../lib/clients';

interface Props {
  viewer: Client;
  space: Client;
  folders: Folder[];
  files: ClientFile[];
  /** The open folder, or undefined for the top level. */
  folder?: Folder;
  msg?: string;
}
const { viewer, space, folders, files, folder, msg } = Astro.props;
const admin = viewer.isAdmin;
const folderIds = new Set(folders.map((f) => f.id));
const shown = folder ? files.filter((f) => f.folderId === folder.id) : files.filter((f) => !folderIds.has(f.folderId));
const counts = new Map<string, number>();
for (const f of files) if (folderIds.has(f.folderId)) counts.set(f.folderId, (counts.get(f.folderId) ?? 0) + 1);
const clientField = admin ? space.id : '';
const accept = Object.keys(ALLOWED_TYPES).map((e) => `.${e}`).join(',');
const from = (f: ClientFile) => (f.uploadedBy === 'client' ? (admin ? 'From client' : 'Uploaded by you') : admin ? 'From you' : 'From Ey-aye');
---
<div class="space">
  {msg && <p class="client-msg" role="alert">{msg}</p>}

  <nav class="space-crumbs" aria-label="Folders">
    {folder ? <a href={spaceUrl(viewer, space)}>All files</a> : <span>All files</span>}
    {folder && <><span aria-hidden="true">›</span><span>{folder.name}</span></>}
  </nav>

  {!folder && (
    <div class="folder-grid">
      {folders.map((f) => (
        <a class="folder-card" href={spaceUrl(viewer, space, f.id)}>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2.5h8.5A1.5 1.5 0 0 1 21 9v9.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z"/></svg>
          <span class="folder-name">{f.name}</span>
          <span class="folder-count">{counts.get(f.id) ?? 0} {(counts.get(f.id) ?? 0) === 1 ? 'file' : 'files'}</span>
        </a>
      ))}
      <details class="folder-card folder-new">
        <summary>+ New folder</summary>
        <form method="post" action="/api/clients/folders">
          <input type="hidden" name="action" value="create">
          {clientField && <input type="hidden" name="client" value={clientField}>}
          <label class="sr-only" for="new-folder">Folder name</label>
          <input id="new-folder" name="name" maxlength="60" required placeholder="Folder name" autocomplete="off">
          <button class="btn btn-teal btn-sm" type="submit">Add</button>
        </form>
      </details>
    </div>
  )}

  {folder && (
    <div class="folder-tools">
      <details>
        <summary>Rename folder</summary>
        <form method="post" action="/api/clients/folders">
          <input type="hidden" name="action" value="rename">
          <input type="hidden" name="folderId" value={folder.id}>
          {clientField && <input type="hidden" name="client" value={clientField}>}
          <label class="sr-only" for="rename-folder">New name</label>
          <input id="rename-folder" name="name" maxlength="60" required value={folder.name} autocomplete="off">
          <button class="btn btn-teal btn-sm" type="submit">Save</button>
        </form>
      </details>
      {admin && (
        <form method="post" action="/api/clients/folders" data-confirm={`Delete the folder “${folder.name}” and the ${shown.length} ${shown.length === 1 ? 'file' : 'files'} in it? Files go to the Media Manager’s trash.`}>
          <input type="hidden" name="action" value="delete">
          <input type="hidden" name="folderId" value={folder.id}>
          <input type="hidden" name="client" value={clientField}>
          <button class="btn-link danger" type="submit">Delete folder</button>
        </form>
      )}
    </div>
  )}

  <div class="upload" data-client={clientField} data-folder={folder?.id ?? ''} data-max={MAX_UPLOAD_BYTES} data-types={Object.keys(ALLOWED_TYPES).join(',')}>
    <label class="upload-drop">
      <input type="file" multiple accept={accept} class="sr-only">
      <strong>Upload files{folder ? ` to ${folder.name}` : ''}</strong>
      <span>Drop them here or click to choose. PDFs, Office files, text and images, up to 50 MB each.</span>
    </label>
    <ul class="upload-list" aria-live="polite"></ul>
  </div>

  {shown.length === 0 ? (
    <p class="client-empty">{folder ? 'This folder is empty.' : folders.length ? 'No loose files. Open a folder above.' : 'Nothing here yet.'}</p>
  ) : (
    <ul class="doc-list">
      {shown.map((d) => (
        <li class="doc">
          <div class="doc-text">
            <a class="doc-title" href={`/clients/doc/${d.id}`}>{d.title}</a>
            <span class="doc-meta">{[longDate(d.date), fileSize(d.sizeInBytes), from(d)].filter(Boolean).join(' · ')}</span>
            {d.note && <p class="doc-note">{d.note}</p>}
          </div>
          <div class="doc-actions">
            <a class="btn btn-outline btn-sm" href={`/clients/doc/${d.id}`} aria-label={`Download ${d.title}`}>Download</a>
            {admin && (
              <form method="post" action="/api/clients/files" data-confirm={`Delete “${d.title}”? It goes to the Media Manager’s trash.`}>
                <input type="hidden" name="action" value="delete">
                <input type="hidden" name="id" value={d.id}>
                <input type="hidden" name="client" value={clientField}>
                {folder && <input type="hidden" name="folderId" value={folder.id}>}
                <button class="btn-link danger" type="submit" aria-label={`Delete ${d.title}`}>Delete</button>
              </form>
            )}
          </div>
        </li>
      ))}
    </ul>
  )}
</div>

<script>
  // Ask before deleting.
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      if (!window.confirm(form.dataset.confirm ?? 'Are you sure?')) e.preventDefault();
    });
  });

  // Uploads: ask our server for a one-off upload URL, send the file straight to Wix, then record it.
  type Started = { uploadUrl: string; mimeType: string; fileName: string };

  async function post(body: Record<string, unknown>) {
    const res = await fetch('/api/clients/upload', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'The upload didn’t work. Please try again.');
    return data;
  }

  function put(url: string, file: File, mimeType: string, onProgress: (n: number) => void): Promise<any> {
    return new Promise((resolve, reject) => {
      const xhr = new XMLHttpRequest();
      xhr.open('PUT', url);
      xhr.setRequestHeader('Content-Type', mimeType);
      xhr.upload.onprogress = (e) => e.lengthComputable && onProgress(e.loaded / e.total);
      xhr.onload = () => {
        if (xhr.status >= 200 && xhr.status < 300) {
          try {
            resolve(JSON.parse(xhr.responseText));
          } catch {
            reject(new Error('The upload didn’t work. Please try again.'));
          }
        } else reject(new Error('The upload didn’t work. Please try again.'));
      };
      xhr.onerror = () => reject(new Error('The upload was interrupted. Please try again.'));
      xhr.send(file);
    });
  }

  document.querySelectorAll<HTMLElement>('.upload').forEach((box) => {
    const input = box.querySelector<HTMLInputElement>('input[type=file]')!;
    const drop = box.querySelector<HTMLElement>('.upload-drop')!;
    const list = box.querySelector<HTMLUListElement>('.upload-list')!;
    const client = box.dataset.client || undefined;
    const folderId = box.dataset.folder || undefined;
    const max = Number(box.dataset.max);
    const types = new Set((box.dataset.types ?? '').split(','));
    let busy = 0;
    let done = 0;

    function row(name: string) {
      const li = document.createElement('li');
      li.className = 'upload-item';
      const label = document.createElement('span');
      label.textContent = name;
      const state = document.createElement('span');
      state.className = 'upload-state';
      state.textContent = 'Waiting…';
      li.append(label, state);
      list.append(li);
      return {
        set: (text: string, cls?: string) => {
          state.textContent = text;
          if (cls) li.classList.add(cls);
        },
      };
    }

    async function one(file: File) {
      const r = row(file.name);
      const ext = (file.name.match(/\.([A-Za-z0-9]{1,8})$/)?.[1] ?? '').toLowerCase();
      if (!types.has(ext)) return r.set('Can’t upload this type of file', 'failed');
      if (file.size > max) return r.set('Over 50 MB', 'failed');
      if (file.size === 0) return r.set('Empty file', 'failed');
      try {
        r.set('Starting…');
        const s: Started = await post({ step: 'start', fileName: file.name, size: file.size, folderId, client });
        const res = await put(s.uploadUrl + (s.uploadUrl.includes('?') ? '&' : '?') + 'filename=' + encodeURIComponent(s.fileName), file, s.mimeType, (p) =>
          r.set(`${Math.round(p * 100)}%`),
        );
        r.set('Saving…');
        await post({ step: 'finish', fileId: res?.file?.id, folderId, client });
        r.set('Done', 'ok');
        done++;
      } catch (err) {
        r.set(err instanceof Error ? err.message : 'Failed', 'failed');
      }
    }

    async function handle(files: FileList | File[]) {
      const arr = Array.from(files);
      if (!arr.length) return;
      busy += arr.length;
      box.classList.add('busy');
      for (const f of arr) {
        await one(f);
        busy--;
      }
      box.classList.remove('busy');
      if (busy === 0 && done > 0) window.setTimeout(() => window.location.reload(), 600);
    }

    input.addEventListener('change', () => {
      if (input.files) handle(input.files);
      input.value = '';
    });
    ['dragenter', 'dragover'].forEach((t) =>
      drop.addEventListener(t, (e) => {
        e.preventDefault();
        drop.classList.add('over');
      }),
    );
    ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, () => drop.classList.remove('over')));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      if ((e as DragEvent).dataTransfer?.files) handle((e as DragEvent).dataTransfer!.files);
    });
  });
</script>
