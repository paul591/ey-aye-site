---
// Every page: head, header with nav, footer.
//
// On Wix the title, description, canonical link and social tags come from Wix, not from here:
//   - ordinary pages: Wix injects them from Dashboard > SEO & GEO > SEO Settings > Main Pages
//   - blog posts: the post page fills the `seo-tags` slot from the post's own SEO settings
// Writing them here as well would give every page two titles. The title, description and og props
// are kept on each page as the wording to use in the dashboard, and are only rendered when a post
// page passes `ownSeo` because Wix's SEO lookup didn't answer in time.
import '../styles/style.css';

export type Nav = 'what' | 'capabilities' | 'how-we-work' | 'work' | 'blog';

interface Props {
  /** The page's title. On Wix it's set in the dashboard (see above); only rendered with `ownSeo`. */
  title?: string;
  description?: string;
  /** Path for the canonical link, e.g. `/blog/`. Omit for pages that shouldn't have one. */
  path?: string;
  /** Open Graph tags in order, as [property, content] pairs. */
  og?: [string, string][];
  /** JSON-LD, already serialised. */
  jsonLd?: string;
  noindex?: boolean;
  /** Which nav item is highlighted. */
  current?: Nav;
  /** Header without nav, and no site script (the thanks page). */
  minimal?: boolean;
  /** Render title, description, canonical and og here: only a post page's fallback sets this. */
  ownSeo?: boolean;
}

const { title, description, path, og = [], jsonLd, noindex = false, current, minimal = false, ownSeo = false } = Astro.props;
const site = 'https://ey-aye.co.uk';
// Signed-in clients see "Client Area"; everyone else "Client Login". Read from Wix's session cookie
// (no API call), so it costs nothing on every page. The /clients/ page does the real check.
let member = false;
try {
  member = Astro.cookies.get('wixSession')?.json()?.tokens?.refreshToken?.role === 'member';
} catch {
  member = false;
}

const nav: [Nav, string, string][] = [
  ['what', '/#what', 'What we do'],
  ['capabilities', '/capabilities/', 'Capabilities'],
  ['how-we-work', '/how-we-work/', 'How we work'],
  ['work', '/work/', 'Projects'],
  ['blog', '/blog/', 'Blog'],
];
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<slot name="seo-tags" />
{ownSeo && (
  <>
    {title && <title>{title}</title>}
    {description && <meta name="description" content={description}>}
    {path && <link rel="canonical" href={site + path}>}
    {og.map(([property, content]) => <meta property={property} content={content}>)}
  </>
)}
{noindex && <meta name="robots" content="noindex">}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="Straight answers — the Ey-aye blog" href="/rss.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Archivo+Black&display=swap">
{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
</head>
<body>

<header class="wrap site-header">
  <a href="/" class="wordmark" aria-label="Ey-aye home"><span>ey</span><span class="bar"></span><span>aye</span><span class="dot"></span></a>
  {!minimal && (
    <>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Open menu"><span class="bars"></span>Menu</label>
      <nav class="site-nav" aria-label="Main">
        {nav.map(([key, href, label]) => <a href={href} class={key === current ? 'current' : undefined}>{label}</a>)}
        <a href={member ? '/clients/' : '/api/auth/login?returnToUrl=/clients/'} class="nav-client" rel="nofollow"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>{member ? 'Client Area' : 'Client Login'}</a>
        <a href="/#book" class="btn btn-teal">Book a look-round</a>
      </nav>
    </>
  )}
</header>

<main>
<slot />
</main>

<footer class="wrap site-footer">
  <div class="footer-grid">
    <div class="footer-col">
      <a href="/" class="wordmark" aria-label="Ey-aye"><span>ey</span><span class="bar"></span><span>aye</span><span class="dot"></span></a>
      <div class="strap">Yorkshire-built AI for Yorkshire businesses. A straight aye or nay, then the bit that's worth building.</div>
      <div class="endorse">a <img src="/assets/loftsoft.png" alt="Loftsoft" style="height: 12px; width: auto; filter: grayscale(1) brightness(0.45)"> service</div>
    </div>
    <div class="footer-col">
      <h4>Site</h4>
      <a href="/#what">What we do</a>
      <a href="/capabilities/">What we can build</a>
      <a href="/how-we-work/">How we work</a>
      <a href="/ai-lead/">Fractional AI lead</a>
      <a href="/work/">Projects</a>
      <a href="/#about">About</a>
      <a href="/blog/">Straight answers</a>
      <a href="/#book">Book a look-round</a>
    </div>
    <div class="footer-col">
      <h4>Get in touch</h4>
      <a href="mailto:paul@ey-aye.co.uk">paul@ey-aye.co.uk</a>
      <span>Harrogate, North Yorkshire</span>
      <a href={member ? '/clients/' : '/api/auth/login?returnToUrl=/clients/'} rel="nofollow">{member ? 'Client Area' : 'Client Login'}</a>
      <h4 style="margin-top: 12px">The small print</h4>
      <a href="/privacy/">Privacy policy</a>
      <a href="/cookies/">Cookies</a>
      <a href="/terms/">Terms</a>
      <a href="/accessibility/">Accessibility</a>
    </div>
  </div>
  <div class="footer-bottom">
    <div>© {new Date().getFullYear()} Loftsoft, trading as Ey-aye. Harrogate, North Yorkshire.</div>
    <div>ICO registration: [REFERENCE]</div>
  </div>
</footer>

{!minimal && <script src="/site.js" defer is:inline></script>}
</body>
</html>
