---
import Base from '../layouts/Base.astro';

const page = {
  "title": "Got it — Ey-aye",
  "noindex": true,
  "minimal": true
};
---
<Base {...page}>
<section class="wrap hero">
  <div class="hero-copy">
    <h1>Aye, got it.</h1>
    <p class="lead">A real person reads every one of these, and you'll hear back within a working day. If it's urgent, email <a href="mailto:paul@ey-aye.co.uk">paul@ey-aye.co.uk</a>.</p>
    <div class="hero-actions"><a href="/" class="btn btn-outline">Back to the site</a></div>
  </div>
</section>
</Base>
