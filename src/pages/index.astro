---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import LookRoundBooking from '../components/LookRoundBooking.astro';
import { getLatestPosts, type PostSummary } from '../lib/posts';

const page = {
  "title": "Ey-aye — Yorkshire-built AI for Yorkshire businesses",
  "description": "Ey-aye is a small Harrogate outfit that builds AI into Yorkshire businesses: a free look-round, a half-day with your own data, and fixed-price builds that join your systems up so you have one place to ask.",
  "path": "/",
  "og": [
    ["og:title", "Ey-aye — Yorkshire-built AI for Yorkshire businesses"],
    ["og:description", "A small Harrogate outfit that says what AI is worth doing in your business, and what it isn't. Then builds the bit that is."],
    ["og:url", "https://ey-aye.co.uk/"],
    ["og:type", "website"],
    ["og:image", "https://ey-aye.co.uk/assets/og.png"]
  ],
  "jsonLd": "{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"ProfessionalService\",\n  \"name\": \"Ey-aye\",\n  \"description\": \"Applied AI for small businesses in Harrogate and North Yorkshire: a free look-round, a half-day with your own data, and fixed-price builds.\",\n  \"url\": \"https://ey-aye.co.uk/\",\n  \"email\": \"paul@ey-aye.co.uk\",\n  \"founder\": {\"@type\": \"Person\", \"name\": \"Paul Lofthouse\"},\n  \"parentOrganization\": {\"@type\": \"Organization\", \"name\": \"Loftsoft\"},\n  \"areaServed\": [\"Harrogate\", \"Knaresborough\", \"Ripon\", \"Wetherby\", \"North Yorkshire\"],\n  \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Harrogate\", \"addressRegion\": \"North Yorkshire\", \"addressCountry\": \"GB\"}\n}"
};
// The three newest posts, from Wix Blog. If the read fails the section is left out.
let latest: PostSummary[] = [];
try {
  latest = await getLatestPosts(3);
} catch {}
---
<Base {...page}>

<div class="hero-band">
<section class="wrap hero" id="top">
  <div class="hero-copy">
    <h1><span class="lead-word">Ey up.</span> Yorkshire&#8209;built AI for Yorkshire businesses<span class="stop">.</span></h1>
    <p class="lead">Ey-aye is a small Harrogate outfit that builds businesses and the systems behind them: the brand, the marketing, the back end, and now the bit where AI makes it all run. We'll come and look at how yours actually works, say what AI is worth doing and what it isn't, then build the bit that is. If the answer's nay, you've lost an hour and a brew.</p>
    <div class="hero-actions">
      <a href="#book" class="btn btn-teal">Book a free look-round</a>
      <a href="#what" class="btn btn-outline">See what we do</a>
    </div>
    <p class="small">Clinics, trades, shops, workshops, small manufacturers and professional services. Harrogate, Knaresborough, Ripon, Wetherby and anywhere within an hour's drive.</p>
  </div>
  <div class="photo hero-photo" style="aspect-ratio: 1 / 1;">
    <!-- Temporary AI-made ident, to be swapped for a real photo. -->
    <img src="/assets/paul-valley-gardens.jpg" width="1200" height="1200" alt="Paul in Harrogate's Valley Gardens, holding up a laptop showing the Ey-aye logo">
  </div>
</section>
</div>

<section class="dark strip" aria-label="Aye or nay">
  <div class="wrap">
    <div class="pair">
      <div class="verdict"><b class="aye">aye</b><span>it can read tomorrow's bookings and brief your front desk before 8am.</span></div>
      <div class="verdict"><b class="nay">nay</b><span>it won't replace Sharon. Sharon knows where everything is.</span></div>
    </div>
    <div class="pair">
      <div class="verdict"><b class="aye">aye</b><span>it can write the quote while you're still in the van.</span></div>
      <div class="verdict"><b class="nay">nay</b><span>it won't send it without you reading it first.</span></div>
    </div>
    <div class="pair">
      <div class="verdict"><b class="aye">aye</b><span>your customer data stays yours, not in somebody's training set.</span></div>
      <div class="verdict"><b class="nay">nay</b><span>nobody's selling you a chatbot here. Nobody wants a chatbot.</span></div>
    </div>
  </div>
</section>

<section class="wrap wrapper" aria-label="Don't buy the wrapper">
  <div class="wrapper-copy">
    <h2>Everyone's worried about missing out on AI. Nobody's sure where it goes.</h2>
    <p class="lead">That's not your fault. The adverts don't help. Every other post on Facebook is a "does it all for you" system for £200 a month, and most of them are a thin wrapper round the same ChatGPT you could use yourself for a tenner.</p>
    <p>Here's the honest order of things. Most businesses get the first big win from using the tools they already pay for properly. Some need those tools plugged into their own systems. A few need something built. We'll tell you which you are, and we won't sell you the third one if the first one does the job.</p>
  </div>
  <div class="wrapper-cards">
    <div class="card-verdict"><b class="nay">nay</b><span>the £200-a-month "AI employee" from a Facebook ad. It's a chatbot with a logo and a contract.</span></div>
    <div class="card-verdict"><b class="aye">aye</b><span>an afternoon learning to make Claude or ChatGPT do your quotes, your emails and your reports the way you'd do them. No new subscription.</span></div>
    <div class="card-verdict"><b class="aye">aye</b><span>when that runs out of road, something built for your systems, that you own, that does the one job properly.</span></div>
  </div>
</section>

<section class="wrap offers" id="what">
  <div class="offers-intro">
    <h2>What we do</h2>
    <p class="lead">Four things, in this order. Most people stop after the second one, and that's fine. <a href="/how-we-work/">How it all fits together →</a></p>
  </div>
  <div class="offer-grid" id="prices">
    <article class="offer">
      <div class="num">01</div>
      <h3><a href="/look-round/" class="offer-link">The look-round</a></h3>
      <div class="price">Free</div>
      <p>An hour at your place. We watch how the work actually flows, ask daft questions, and say where AI would save real time and where it would just be a toy. You get a one-page aye/nay list. No pitch.</p>
      <a href="/look-round/" class="more">About the look-round →</a>
    </article>
    <article class="offer featured">
      <div class="num">02 · Most people start here</div>
      <h3><a href="/half-day/" class="offer-link">The half-day</a></h3>
      <div class="price">£350</div>
      <p>Four hours at your place with Claude or ChatGPT and your own data: last month's bookings, the quotes you sent, the spreadsheet you dread. By the end you've built a dashboard or a report yourself, you know what to ask for, and you know what must never go into a public AI: where your data lives, what gets trained on, how to keep customer lists and your own IP out of it. No new subscription, no jargon, and you keep every prompt we write together.</p>
      <a href="/half-day/" class="more">About the half-day →</a>
    </article>
    <article class="offer">
      <div class="num">03</div>
      <h3><a href="/build/" class="offer-link">The build</a></h3>
      <div class="price">From £2,500</div>
      <p>One job, fixed price, four weeks. We take the biggest aye from the look-round and build it into the tools you already use: Wix, Shopify, Xero, QuickBooks, your booking system. You see it working every week, not at the end. You own it.</p>
      <p class="small">Already know what you need? For larger businesses opening their own software and systems to AI, we build bespoke MCP servers and the governance around them. <a href="#book">Get in touch</a>.</p>
      <a href="/build/" class="more">About the build →</a>
    </article>
    <article class="offer">
      <div class="num">04</div>
      <h3><a href="/fed-and-watered/" class="offer-link">Fed and watered</a></h3>
      <div class="price">From £150 a month</div>
      <p>Keeping what we built running. Updates when your software changes, a check-in each month, and a real person on the end of the phone when something looks odd. Cancel whenever. Nothing breaks if you do.</p>
      <a href="/fed-and-watered/" class="more">About fed and watered →</a>
    </article>
  </div>
</section>

<section class="white ask" aria-label="One place to ask">
  <div class="wrap">
    <div class="ask-copy">
      <h2>Give your business one place to ask.</h2>
      <p class="lead">Your business already knows the answer to most questions. The trouble is the answer's split across five logins. Bookings in one place, invoices in another, the customer's last email somewhere else, the stock in a spreadsheet.</p>
      <p>We join those up so an AI can see all of them at once, safely, read-only where it should be. Then you ask it like you'd ask a good office manager: "Who's in this week that still owes us?" "What did we quote the Smiths last time?" "Which lines haven't sold since spring?" Once that's in place, the automation builds on top of it: the morning brief, the quote that writes itself, the chase that goes out on Friday.</p>
    </div>
    <div class="flow" aria-label="How it fits together">
      <div class="chips">
        <span class="chip">Wix bookings</span><span class="chip">Xero / QuickBooks</span><span class="chip">Shopify</span><span class="chip">Email and calendar</span><span class="chip">The spreadsheet</span><span class="chip">The job system</span>
      </div>
      <div class="arrow" aria-hidden="true">→</div>
      <div class="hub">One place to ask</div>
      <div class="arrow" aria-hidden="true">→</div>
      <div class="chips out">
        <span class="chip dark">The morning brief</span><span class="chip dark">The quote that writes itself</span><span class="chip dark">The Friday chase</span>
      </div>
    </div>
    <p class="small">Nothing leaves your systems to be trained on. The AI reads what it's allowed to and no more, and every answer shows where it got it from. That's one of nine things on the <a href="/capabilities/">full list of what we can build</a>.</p>
  </div>
</section>

<section class="wrap case" aria-label="Case study">
  <div class="case-panel">
    <div class="case-copy">
      <div class="kicker">Bodyworks by Corey, Harrogate · Corey's clinic, our back end · the first build</div>
      <h2>Every morning, a one-page brief on who's walking in today.</h2>
      <p>New or returning, last seen, what they booked, what they said on the intake form, where their package is up to. Read over the first brew. No typing, no digging through Wix. We launched the brand and built the booking system, so this was the obvious first job.</p>
      <a href="/work/#bodyworks">Read how it was built →</a>
    </div>
    <div class="photo case-photo"><img src="/assets/work/bodyworks-brief.jpg" width="1600" height="1200" alt="The Bodyworks morning brief on a phone: the 12:30 appointment, paid on package, waiver signed, two treatment flags and visit history, with the client's name and notes blurred" loading="lazy"></div>
  </div>
</section>

<section class="white about" id="about">
  <div class="wrap">
    <div class="photo about-photo">[Photo: Paul in the workshop or beside the van. Not a headshot.]</div>
    <div class="about-copy">
      <h2>Software engineer for life. Business builder by habit.</h2>
      <p>Ey-aye is Paul Lofthouse. I've been writing software for thirty years, from before I studied software engineering at Nottingham, and I've lived on the bleeding edge of it ever since. Race-car data systems, dynamometers and embedded vehicle electronics, yes, but also huge web architectures, plant-wide SCADA systems, and native apps on Windows, Linux and mobile. If it's software engineering or architecture, the odds are I've built it, usually more than once.</p>
      <p>Lately that's meant building with AI from the inside, not just typing into it, so I know what these models are good at and where they bluff. My day job is with an automotive software company whose tools sit inside major car makers' engineering teams, and the biggest AI product I've shipped is theirs: an assistant that lets engineers ask their calibration platform questions in plain English. The same idea runs my own race-data system, which you can see.</p>
      <p>I've also launched and run brands of my own. Bodyworks by Corey is the massage and lymphatic drainage practice in Harrogate that Corey founded: she's the therapist, and I launched the brand and run the bookings, the marketing and everything behind the front desk. Her name for the job is "back-end boy". Purple Helmet, the motorsport apparel brand, is mine end to end: brand, store, community, back end.</p>
      <p>Software and motorsport are what I live, sleep and breathe. So when I say something's worth doing, it's because I've had to make it pay in a business I own, not because it looked good in a slide deck. And if it's worth building, I build it myself.</p>
      <div class="about-meta">
        <span>Based in Harrogate</span>
        <span>Back end at <a href="https://bodyworksbycorey.co.uk">Bodyworks by Corey</a> · Founded <a href="https://purple-helmet.com">Purple Helmet</a></span>
        <span class="endorse">a <img src="/assets/loftsoft.png" alt="Loftsoft"> service</span>
      </div>
    </div>
  </div>
</section>

{latest.length > 0 && (
<section class="wrap blog" id="blog">
  <div class="blog-head">
    <h2>Straight answers</h2>
    <a href="/blog/">All posts →</a>
  </div>
  <div class="post-grid">
    {latest.map((post) => <PostCard post={post} summary={false} />)}
  </div>
</section>
)}

<section class="dark book" id="book">
  <div class="wrap">
    <div class="book-copy">
      <h2>Book a look-round</h2>
      <p>Pick an hour and we'll come to you. If you'd rather talk first, the form reaches a person, not a bot.</p>
      <LookRoundBooking />
    </div>
    <form class="form" action="/api/enquiry" method="POST" aria-label="Contact form">
      <input type="hidden" name="landing" value="/">
      <input type="checkbox" name="botcheck" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true">
      <label>Your name<input type="text" name="name" required></label>
      <label>Your business<input type="text" name="business"></label>
      <label>Email<input type="email" name="email" required></label>
      <label>What's eating your time?<textarea name="message" rows="4"></textarea></label>
      <label>How did you hear about us?<select name="heard_about">
        <option value="">Choose one</option>
        <option>Facebook</option>
        <option>Instagram</option>
        <option>LinkedIn</option>
        <option>Google search</option>
        <option>Our blog</option>
        <option>Someone recommended you</option>
        <option>Met at an event</option>
        <option>Other</option>
      </select></label>
      <button type="submit" class="btn btn-rapeseed">Send it</button>
    </form>
  </div>
</section>

</Base>
