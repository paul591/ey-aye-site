---
// /clients/: a signed-in client's own file space. Anyone not signed in goes to Wix's login page and
// comes back here; an admin goes to /clients/admin/ to pick a client.
import Base from '../../layouts/Base.astro';
import ClientSpace from '../../components/ClientSpace.astro';
import { currentClient, filesFor, foldersFor, isId, LOGIN_URL, LOGOUT_URL, type ClientFile, type Folder } from '../../lib/clients';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const viewer = await currentClient();
if (!viewer) return Astro.redirect(LOGIN_URL);
if (viewer.isAdmin) return Astro.redirect('/clients/admin/');

let folders: Folder[] = [];
let files: ClientFile[] = [];
let failed = false;
try {
  [folders, files] = await Promise.all([foldersFor(viewer), filesFor(viewer)]);
} catch (err) {
  console.error('client space failed', err);
  failed = true;
}
const folderParam = Astro.url.searchParams.get('folder');
const folder = isId(folderParam) ? folders.find((f) => f.id === folderParam) : undefined;
const rawMsg = Astro.url.searchParams.get('msg') ?? '';
const msg = /^[A-Za-z’'., -]{1,120}$/.test(rawMsg) ? rawMsg : undefined;
const firstName = viewer.name.split(' ')[0];
---
<Base title="Your files — Ey-aye" noindex>
<section class="wrap hero client-area">
  <div class="hero-copy">
    <p class="kicker teal">Client area</p>
    <h1>{firstName ? `Ey up, ${firstName}` : 'Ey up'}<span class="stop">.</span></h1>
    <p class="lead">Everything we share with you, and anything you want to send us. Download links last fifteen minutes, so use this page rather than bookmarking them.</p>
  </div>

  {failed ? (
    <p class="client-empty">Your files won't load just now. Try again in a minute, or email <a href="mailto:paul@ey-aye.co.uk">paul@ey-aye.co.uk</a>.</p>
  ) : (
    <ClientSpace viewer={viewer} space={viewer} folders={folders} files={files} folder={folder} msg={msg} />
  )}

  <form method="post" action={LOGOUT_URL} class="client-signout">
    <span>Signed in as {viewer.email || viewer.name}.</span>
    <button type="submit" class="btn btn-outline btn-sm">Sign out</button>
  </form>
</section>
</Base>
