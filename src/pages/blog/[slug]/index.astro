---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { cardImage, getPosts, headerImage, isoDate, longDate, postPath, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { data } = post;
const { Content } = await render(post);
const site = 'https://ey-aye.co.uk';
const url = site + postPath(post);

// The headline's closing full stop is drawn in Rapeseed.
const endsWithStop = data.title.endsWith('.');
const headline = endsWithStop ? data.title.slice(0, -1) : data.title;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  author: { '@type': 'Organization', name: 'Ey-aye' },
  publisher: { '@type': 'Organization', name: 'Ey-aye' },
  datePublished: isoDate(data.date),
  ...(data.updated ? { dateModified: isoDate(data.updated) } : {}),
  mainEntityOfPage: url,
});
---
<Base
  title={`${data.title} — Ey-aye`}
  description={data.description}
  path={postPath(post)}
  og={[
    ['og:title', data.title],
    ['og:description', data.socialDescription ?? data.description],
    ['og:url', url],
    ['og:type', 'article'],
    ['og:image', site + cardImage(post)],
    ['og:image:width', '1200'],
    ['og:image:height', '630'],
  ]}
  jsonLd={jsonLd}
  current="blog"
>
<article class="wrap article">
  <header>
    <div class="meta">Straight answers · {longDate(data.date)} · {data.readTime} min read</div>
    <h1>{headline}{endsWithStop && <span class="stop">.</span>}</h1>
    <p class="lead">{data.lead}</p>
  </header>

  <div class="photo hero-img"><img src={headerImage(post)} alt={data.heroAlt} width="1600" height="900"></div>

  <div class="body">
    <Content />
  </div>

  <div class="cta">
    <div class="line">{data.cta}</div>
    <a href="/#book" class="btn">{data.ctaButton}</a>
  </div>
</article>
</Base>
